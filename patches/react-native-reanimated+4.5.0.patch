+
+  virtual void updateKeyframes(jsi::Runtime &rt, const jsi::Value &keyframes) = 0;
+  virtual bool updateKeyframes(jsi::Runtime &rt, const jsi::Value &fromValue, const jsi::Value &toValue) = 0;
